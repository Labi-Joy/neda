generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Invoice {
  id               String    @id
  ownerNearId      String
  clientName       String
  clientEmail      String?
  amountUsd        Float
  dueDate          DateTime
  memo             String?
  lineItems        String    @db.Text
  status           String    @default("pending")
  correlationId    String?
  depositAddresses String?   @db.Text
  destinationAsset String?
  paidAt           DateTime?
  txHash           String?
  receivedAmount   Float?
  receivedAsset    String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([ownerNearId])
  @@index([status])
}
